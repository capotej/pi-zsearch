{
	"name": "@capotej/pi-zsearch",
	"version": "1.0.0",
	"type": "module",
	"description": "Adds web_search and web_read tools powered by the Z.AI API.",
	"keywords": ["pi-package", "zai", "zsearch"],
	"license": "MIT",
	"author": "Julio Capote <6135+capotej@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/capotej/pi-zsearch.git"
	},
	"files": ["index.js", "index.d.ts", "README.md", "LICENSE"],
	"pi": {
		"extensions": ["./index.js"]
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*"
	},
